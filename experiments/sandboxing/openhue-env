#!/bin/sh
set -eu

if [ -n "${HUE_BRIDGE_IP:-}" ] || [ -n "${HUE_APP_KEY:-}" ]; then
    if [ -z "${HUE_BRIDGE_IP:-}" ] || [ -z "${HUE_APP_KEY:-}" ]; then
        echo "HUE_BRIDGE_IP and HUE_APP_KEY must be set together" >&2
        exit 1
    fi

    openhue_home=$(mktemp -d)
    export HOME="$openhue_home"
    umask 077
    /usr/local/libexec/openhue config \
        --bridge "$HUE_BRIDGE_IP" \
        --key "$HUE_APP_KEY" \
        >/dev/null
fi

exec /usr/local/libexec/openhue "$@"
